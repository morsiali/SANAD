# SANAD server configuration (copy to .env or set in your host). No secrets are required: without them everything works and the assistant stays rule-based.

# Port for the API and web app
PORT=4000

# Where data is saved (JSON file). Older data files are upgraded automatically on start.
SANAD_DATA=data/sanad.json

# Not used yet — listed so it is clear what is NOT configured:
# Email delivery for invitations (Phase 4). Until set, invitations are shared by copying a link.
# SANAD_SMTP_URL=

# Optional AI model for the assistant's written overview (Phase 3). Server-side only; never sent to the browser.
# When unset, the assistant uses SANAD's own rules and says so on every answer.
# ANTHROPIC_API_KEY=
# SANAD_MODEL=claude-sonnet-5-5
# SANAD_MODEL_TIMEOUT_MS=20000
