# SANAD server configuration (copy to .env or set in your host). See docs/DEPLOYMENT.md for the full checklist.
# Without any settings SANAD starts in demo mode with synthetic people (never use demo mode for real data).

# Port for the API and web app
PORT=4000

# Where data is saved (JSON file + a files/ folder next to it). Older data files are upgraded automatically on start.
SANAD_DATA=data/sanad.json

# ---- Real use -------------------------------------------------------------
# NODE_ENV=production turns demo mode off: no demo accounts list, no reset, HSTS on.
# NODE_ENV=production
# SANAD_DEMO=0
# First start only: creates an empty workspace with one care coordinator (password at least 12 characters).
# SANAD_ORG_NAME=Your organisation
# SANAD_ADMIN_NAME=First Coordinator
# SANAD_ADMIN_EMAIL=coordinator@example.org
# SANAD_ADMIN_PASSWORD=
# Behind a reverse proxy (needed for correct sign-in limits per address):
# SANAD_TRUST_PROXY=1
# Optional tuning:
# SANAD_SESSION_HOURS=12
# SANAD_LOGIN_ATTEMPTS=5
# SANAD_LOGIN_WINDOW_MINUTES=15
# SANAD_HSTS=1

# ---- Optional AI model for the assistant's written overview -----------------
# Server-side only; never sent to the browser. When unset, the assistant uses SANAD's own rules and says so.
# ANTHROPIC_API_KEY=
# SANAD_MODEL=claude-sonnet-5-5
# SANAD_MODEL_TIMEOUT_MS=20000

# ---- Not built yet (listed so it is clear what is NOT connected) ------------
# Email / SMS / WhatsApp delivery: notifications are in-app only.
# Virus scanning for uploaded files.
